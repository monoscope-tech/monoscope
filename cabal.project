-- kafka-effectful 0.3.0.0 (Eff KafkaConsumer/KafkaProducer effects for
-- hw-kafka-client). Pulled from git, not Hackage, because 0.3.0.0 — the only
-- release that supports hs-opentelemetry-api 1.0 — was published after our
-- pinned index-state (0.2.0.0 still wants otel-api 0.3.x).
-- Bumping this tag no longer needs a manual audit: runSharedKafkaProducer in
-- src/Pkg/Queue.hs now spells out every KafkaProducer constructor instead of
-- using a wildcard, so a newly-added op is a compile error there (and in the
-- Kafka mock in Opentelemetry.IngestionSpec) rather than a runtime panic in production.
source-repository-package
  type: git
  location: https://github.com/shinzui/kafka-effectful.git
  tag: f9e1eb14e6e769754130aabc6027ebc3e32e380b
  subdir: .

-- Fork of iand675's 484370c plus one commit: http-client records a low-cardinality error.type
-- (status code / constructor) and a short status. Upstream set both to the shown exception,
-- whose per-request headers made every failed call its own issue (prod 2026-11-22).
source-repository-package
  type: git
  location: https://github.com/tonyalaribe/hs-opentelemetry
  tag: 6306ddded00cb72d56f71834d651ebcc84a9e4ca
  subdir: api-types
  subdir: semantic-conventions
  subdir: api
  subdir: sdk
  subdir: otlp
  subdir: exporters/otlp
  subdir: exporters/handle
  subdir: exporters/in-memory
  subdir: exporters/prometheus
  subdir: propagators/w3c
  subdir: propagators/b3
  subdir: propagators/datadog
  subdir: propagators/jaeger
  subdir: propagators/xray
  subdir: instrumentation/wai
  subdir: instrumentation/conduit
  subdir: instrumentation/http-client
  subdir: instrumentation/postgresql-simple
  subdir: instrumentation/hw-kafka-client
  subdir: utils/exceptions

