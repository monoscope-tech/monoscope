{
  "name": "monaco-aql-editor",
  "version": "1.0.0",
  "description": "Monoscope web components and query editor",
  "scripts": {
    "dev": "vite",
    "watch": "vite build --watch --mode development",
    "build": "vite build",
    "build-with-types": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:query:schema": "node bench/schema.mjs",
    "bench:query:build": "vite build --config bench/vite.config.ts",
    "bench:query:serve": "vite preview --config bench/vite.config.ts --port 3099",
    "bench:query:browser": "node bench/browser.mjs",
    "test:query:browser": "playwright test --config bench/playwright.config.ts"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lit-labs/virtualizer": "^2.1.1",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "@napi-rs/canvas": "^1.0.13",
    "@rrweb/replay": "^2.1.7",
    "@rrweb/types": "^2.0.0-alpha.18",
    "@types/lodash": "^4.17.27",
    "ansi-up": "^1.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "elkjs": "^0.12.0",
    "js-yaml": "^4.3.2",
    "jsonpath": "^1.3.0",
    "lit": "^3.3.3",
    "lodash": "^4.17.23",
    "monaco-editor": "^0.57.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonpath": "^0.2.4",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.5",
    "happy-dom": "^21.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.5",
    "vitest-canvas-mock": "^1.2.0"
  },
  "overrides": {
    "dompurify": "^3.3.2",
    "underscore": "^1.13.8"
  }
}
