import json,sys
from _guard import should_block
payload=json.load(sys.stdin)
assert type(payload['approved']) is bool
blocked=should_block({'reviewed':payload['approved']})
print('BLOCK' if blocked else 'ALLOW')
sys.exit(2 if blocked else 0)

