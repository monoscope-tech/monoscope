import json,pathlib,subprocess,sys
payload=json.load(sys.stdin)
assert type(payload['approved']) is bool
helper=pathlib.Path(__file__).with_name('_bridge.py')
result=subprocess.run([sys.executable,str(helper),json.dumps(payload)])
sys.exit(result.returncode)

