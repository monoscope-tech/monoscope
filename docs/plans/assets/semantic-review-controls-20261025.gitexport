import pathlib,sys
helper=pathlib.Path(__file__).with_name('_guard.py')
if not helper.exists():
    print('SKIPPED:private helper absent')
    sys.exit(0)
from _guard import should_block
print('REACHED:private helper')
assert should_block({'approved':False}), 'configured CLI must block unapproved input'

