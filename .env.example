# --- Live Tail -------------------------------------------------------------
# Streams matching logs to the browser over SSE, matched on the ingest pod before the
# TimeFusion/Postgres write. On by default; every value below already has a working default.
#
# ENABLE_LIVE_TAIL=True
# LIVE_TAIL_TOPIC=live_tail        # Kafka side-topic, only used when ENABLE_KAFKA_SERVICE=True.
#                                  # Single-process deployments use an in-process hub and
#                                  # ignore this. Create it with short retention:
#                                  #   rpk topic create live_tail -p 6 -r 1 \
#                                  #     -c retention.ms=600000 -c retention.bytes=67108864
# LIVE_TAIL_LEASE_SECS=45          # Subscriptions expire unless the open tab keeps renewing.
# LIVE_TAIL_CACHE_REFRESH_SECS=2   # Also the worst-case delay before a new tail starts matching.
# LIVE_TAIL_QUEUE_CAPACITY=500     # Rows buffered per browser before the oldest is dropped.
# LIVE_TAIL_MAX_PER_USER=3
# LIVE_TAIL_MAX_PER_PROJECT=20
# LIVE_TAIL_MAX_CACHED=500         # Hard cap on subscriptions one ingest pod will hold.
