DATABASE_URL="host=localhost user=postgres password=postgres dbname=monoscope port=5432 sslmode=disable"
PORT=8080
GRPC_PORT=4317
MIGRATIONS_DIR="./static/migrations/"
ENVIRONMENT=DEV
LOG_LEVEL=Trace
LOGGING_DESTINATION=StdOut

BASIC_AUTH_ENABLED=True
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=changeme

# Generic OpenID Connect for interactive browser login. Basic Auth is a
# separate, mutually exclusive authentication mode; set BASIC_AUTH_ENABLED=False
# when OIDC should drive /login, /auth_callback, and /logout.
OIDC_ENABLED=False
OIDC_ISSUER=https://identity.example.com
# Optional when it is the issuer plus /.well-known/openid-configuration.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=monoscope
OIDC_CLIENT_SECRET=replace-with-registered-client-secret
OIDC_CALLBACK_URL=https://monoscope.example.com/auth_callback
OIDC_LOGOUT_REDIRECT=https://monoscope.example.com/
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_ALGORITHMS=RS256
# disabled or verified_email. Keep disabled unless verified-email linking is intended.
OIDC_EXISTING_USER_LINK_MODE=disabled
# Requires an explicit email_verified=true claim; unverified emails fail closed.
OIDC_AUTO_REGISTER=False

TEST_EMAIL=
API_KEY_ENCRYPTION_SECRET_KEY=monoscope123456monoscope12345678

SENDGRIDAPIKEY=
MIGRATE_AND_INITIALIZE_ON_START=True

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://app.monoscope.tech/slack/oauth/callback

ENABLE_PUBSUB_SERVICE=True

ENABLE_PUBSUB_SERVICE=True
ENABLE_BACKGROUND_JOBS=True
POSTMARK_TOKEN=
ENABLE_BROWSER_MONITORING=False

# GitHub App integration (for GitHub sync feature)
# See GITHUB_INTEGRATION_PLAN.md for setup instructions
GITHUB_APP_ID=
GITHUB_APP_NAME=monoscope
GITHUB_APP_PRIVATE_KEY=

GH_TEST_PAT="ghp_your_token"
GH_TEST_OWNER="monoscope-tech"
GH_TEST_REPO="monoscope-sync-test"

CYPRESS_RECORD_KEY=

FONTAWESOME_PRO_TOKEN=your_pro_kit_token_here
